{
  "manifest_version": 3,
  "name": "Page2LLM — صفحه‌خوان هوش مصنوعی",
  "short_name": "Page2LLM",
  "version": "1.1.0",
  "description": "استخراج متن تمیز صفحه و تبدیل به مارک‌داون آماده برای LLM — ۱۰۰٪ محلی | Clean page text → Markdown for LLMs. 100% local.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Page2LLM — صفحه‌خوان هوش مصنوعی",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open Page2LLM popup"
    }
  }
}
